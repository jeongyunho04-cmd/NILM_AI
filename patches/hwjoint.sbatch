#!/bin/bash
# 14.44 ③ — **결합**을 센다: 오븐이 통전 중 **이면서** 반파가 미래에 처음 켜지는 창.
#
# 14.44 에서 셋이 연달아 반증됐다 (생성기가 배치를 안 만드는 게 아니다):
#   전환 일반      합성 47.9% 대 실측 49.9%   — 같다
#   핫플 듀티      합성 100% 중앙 21 대 실측 100% 중앙 18 — 합성이 더 많다
#   날카로운 계수   합성 4.17% 대 실측 3.46%   — 합성이 더 많다
# 남은 것은 **결합**이다. 14.43 ② 의 표가 그것을 가리킨다 (오븐 통전 창 안에서만 갈렸다).
#
# **실측 기준선** (조인 자 · `--sharp` · 336창):
#   미래 전환 있음 **111창 -> 붕괴 25.2 / 17.1 / 22.5%**
#   미래 전환 없음  225창 -> 붕괴 **0.0 / 0.0 / 0.0%**
#   ⇒ 붕괴가 **전부** 그 111창 안에 있다.
#
# **반증 가능한 예측**:
#   ① 합성에서 그 결합 창이 실측 111/336=33% 보다 **훨씬 적으면** 원인은 결합 빈도다.
#   ② 결합 창이 비슷한데 **붕괴율만 낮으면** 빈도가 아니다 — 같은 배치를 합성에서는
#      제대로 처리한다는 뜻이고, 남는 차이는 증거의 **크기·지속**이다 (`_stats` 줄).
#   ③ ⚠ 합성의 '전환 없음' 붕괴가 실측처럼 0.0% 인지 봐라. 그래야 자가 같은 것을 잰다.
#
# ⚠⚠ **14.47 추가** — `_stats` 가 **무딘 자의 부분집합**을 서술하고 있던 것을 고쳤다.
#   이제 판정에 쓴 마스크 그대로 찍는다. 실측 결합 창 111개를 그렇게 다시 보니:
#       타깃 |I2| 0.212 · 과거 최대 0.479 · **미래 최대 3.793**
#       **미래 점유 0%** (p75 19%) · 켜진 시간 **0.02초/6.0초** · 켜지는 시점 타깃 **+3.08초**
#   즉 미래 증거가 '기기가 켜져서 계속' 이 아니라 **1~2사이클 순간 스파이크**다.
#   그리고 전환 없는 225창은 **과거 최대가 2.427** 인데(반파가 과거에 있다) **붕괴 0.0%** 다.
#   ⇒ **과거에 있으면 안 무너지고 미래에 한 사이클만 튀어도 무너진다.**
#   ④ 합성에서 같은 줄을 찍어라 — 점유·켜진 시간·켜지는 시점이 실측과 어떻게 다른가.
#      합성이 '계속 켜져 있음'(점유 100%)이면 **생성기에 순간 스파이크가 없다**는 뜻이고,
#      그것이 12.37 의 과도 3채널이 반증된 뒤 남은 구멍일 수 있다.
#
#SBATCH -J nilm_hwj
#SBATCH -p gpu2,gpu6,gpu4,gpu5,gpu3,gpu1
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 8
#SBATCH --gres=gpu:1
#SBATCH --mem=60G
# ⚠⚠ `-t` 는 **실측의 1.5배**다 (HPC_RULES §2). 짧을수록 backfill 이 잘 문다 —
#   `-t 01:15` 로 3.2배를 불렀다가 시드 1·2 가 한 시간을 섰다 (983243, 2026-09-14).
#   ⚠ `squeue --start`·`sbatch --test-only` 는 **backfill 을 모델링하지 않는다** —
#     모양을 바꿔도 같은 날짜가 나온다. 그 값으로 '자리가 없다' 고 읽지 마라.
#SBATCH -t 00:10:00     # 실측 2.5분(983222)
#SBATCH -o %x_%j.out
#SBATCH -e %x_%j.out
set -euo pipefail
cd "$HOME/NILM_AI"
PY=./env/bin/python
echo "노드 $(hostname) · $(date '+%F %H:%M:%S')"
$PY -X utf8 -m src.run_diag_hwfuture --help | grep -q -- "--sharp" || {
  echo "--sharp 가 없다 — 코드를 안 올렸다"; exit 1; }
$PY -X utf8 -m src.run_diag_hwfuture --sharp --holdout processed_data/holdout60_v32 \
    --ckpt results/cnn_vncls_res_s0.pt results/cnn_vncls_res_s1.pt results/cnn_vncls_res_s2.pt
echo "끝 $(date '+%F %H:%M:%S')"
