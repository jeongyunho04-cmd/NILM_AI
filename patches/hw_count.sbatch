#!/bin/bash
# 14.44 ① — **반파 기기가 창 중간에 '처음' 켜지는 배치**가 합성에 몇 % 인가. 모델 없이 입력만.
#
# 14.43 ② 가 `|I2|` 의 '미래평균 − 과거평균' 으로 쟀는데 그 자는 **이미 켜져 있고 값이 조금
# 오르는 것**도 같이 센다 — 합성이 정확히 그랬다 (타깃 |I2| 3.493 · 미래 점유 100%).
# 여기서는 **타깃·과거 전체에서 없고(<0.5) 미래에 있는(>2.0)** 것만 센다.
#
# **실측 기준선** (같은 도구 `--real`, 16,496창):
#   날카로운 계수 **3.46%** (571창) │ 타깃에 이미 켜짐 7.37% │ 미래 어딘가 48.08%
#   ⚠ 그 571창의 **미래 구간 점유 중앙이 0%** 다 — 상당수가 기기 켜짐이 아니라 **순간 스파이크**다.
#   전환 일반은 실측 49.9% · 합성 47.9% 로 **거의 같다** (14.43 ④ 에서 이미 반증됐다).
#
# **반증 가능한 예측**:
#   ① 합성의 날카로운 계수가 실측 3.46% 보다 **훨씬 낮으면** 14.43 ② 의 좁은 형태가 맞다.
#   ② 비슷하면 그것도 아니다 — 그러면 남는 차이는 **점유·지속**이거나 다른 축이다.
#   ③ ⚠ 점유 중앙을 꼭 봐라. 실측이 0% 면 '켜짐' 이 아니라 스파이크를 센 것이고,
#      그때는 문턱이 아니라 **자를 다시 짜야 한다.**
#
#SBATCH -J nilm_hwc
#SBATCH -p cpu1,gpu6,cpu2,gpu3,gpu4,gpu5
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 8
#SBATCH --mem=60G
# ⚠⚠ `-t` 는 **실측의 1.5배**다 (HPC_RULES §2). 짧을수록 backfill 이 잘 문다 —
#   `-t 01:15` 로 3.2배를 불렀다가 시드 1·2 가 한 시간을 섰다 (983243, 2026-09-14).
#   ⚠ `squeue --start`·`sbatch --test-only` 는 **backfill 을 모델링하지 않는다** —
#     모양을 바꿔도 같은 날짜가 나온다. 그 값으로 '자리가 없다' 고 읽지 마라.
#SBATCH -t 00:10:00     # 실측 1분(983211)
#SBATCH -o %x_%j.out
#SBATCH -e %x_%j.out
set -euo pipefail
cd "$HOME/NILM_AI"
PY=./env/bin/python
echo "노드 $(hostname) · $(date '+%F %H:%M:%S')"
$PY -X utf8 -m src.run_diag_wintrans --holdout processed_data/holdout60_v32 --step 300
echo "끝 $(date '+%F %H:%M:%S')"
