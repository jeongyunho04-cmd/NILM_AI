#!/bin/bash
# 14.43 ④ — **창 안 전환이 합성 캐시/홀드아웃에 정말 없나.** 전력 계단으로 넓게 센다.
#
# 14.43 은 `|I2|`(반파 증거) 하나만, 오븐 통전 창에서만 봤다. 사용자: *"창 안 전환이
# 캐시에 없었나?"* -> 기기를 안 가리고 전력 계단으로 다시 센다.
#
# **실측 기준선은 이미 쟀다** (같은 도구 `--real`, 16,496창):
#   문턱 100W: 전환 있는 창 **49.9%** │ 앞만 5.2% │ 뒤만 7.6% │ 양쪽 37.1%
#              핫플 ON 창 **100.0%** · 창당 중앙 **18** (핫플 릴레이 주기 2초)
#              오븐 90.1% (중앙 16) · 포트 73.4% (11) · 드라이 69.2% (2)
#   문턱 300W: 전환 있는 창 48.9% · 핫플 98.4% (중앙 8) · 오븐 88.3% (4)
#
# **반증 가능한 예측**:
#   ① 14.43 ② 가 맞다면 합성의 '전환 있는 창' 비율이 실측 49.9% 보다 **훨씬 낮아야** 한다.
#   ② 특히 **핫플 ON 창**: 실측은 100% · 중앙 18 이다. 합성이 0 에 가까우면 생성기가
#      **릴레이 듀티를 창 안에 안 담는다**는 뜻이고, 문제는 오븐 하나가 아니라
#      **듀티 기기가 든 창 전체**다.
#   ③ ⚠ 반대로 합성도 50% 근처면 **전환 일반은 있는 것**이고, 없는 것은 14.43 ② 가 짚은
#      **'반파 기기가 창 중간에 켜지는' 특정 배치**뿐이다. 그러면 처방이 훨씬 좁아진다.
#   ④ ⚠ 계단 문턱 100W 와 300W 를 같이 본다. 100W 는 잔물결을 셀 수 있다.
#
#SBATCH -J nilm_wtr
#SBATCH -p gpu3,gpu4,gpu5,gpu6,cpu1,cpu2
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 8
#SBATCH --mem=60G
#SBATCH -t 00:30:00
#SBATCH -o %x_%j.out
#SBATCH -e %x_%j.out
set -euo pipefail
cd "$HOME/NILM_AI"
PY=./env/bin/python
echo "노드 $(hostname) · $(date '+%F %H:%M:%S')"
test -d processed_data/holdout60_v32 || { echo "홀드아웃이 없다"; exit 1; }
for S in 100 300; do
  $PY -X utf8 -m src.run_diag_wintrans --holdout processed_data/holdout60_v32 --step "$S"
done
# ⚠⚠ 끝단에서 mmlsquota 를 부르지 않는다 (HPC_RULES §7-5).
echo "끝 $(date '+%F %H:%M:%S')"
